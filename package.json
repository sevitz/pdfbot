{
  "name": "pdfbot",
  "version": "0.3.5",
  "description": "One click Save as PDF for any web page, done in the browser with no print dialog.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
