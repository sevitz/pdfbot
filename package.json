    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "test": "node --test src/"
  },
  "dependencies": {
    "html2canvas-pro": "^2.6.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
